# Konfigurationen, die gemessen werden. Eine Zeile = eine Konfiguration.
# harness: "claude" | "codex"   plan: Schlüssel aus plans.toml
# effort Claude: low|medium|high|xhigh|max   effort Codex: minimal|low|medium|high|xhigh

[[config]]
id = "cc-sonnet5-medium"
harness = "claude"
model = "claude-sonnet-5"
effort = "medium"
plan = "claude-max-20x"

[[config]]
id = "cc-opus55-medium"
harness = "claude"
model = "claude-opus-5-5"
effort = "medium"
plan = "claude-max-20x"

[[config]]
id = "cx-gpt6sol-medium"
harness = "codex"
model = "gpt-6-sol"
effort = "medium"
plan = "chatgpt-pro-20x"

[[config]]
id = "cx-gpt6sol-high"
harness = "codex"
model = "gpt-6-sol"
effort = "high"
plan = "chatgpt-pro-20x"

[defaults]
repeats = 3
quota_mode = "block"          # block | single
task_timeout_s = 1800
startup_timeout_ms = 60000
limit_pause_threshold = 98    # ab diesem %-Stand pausieren
quality_floor = 0.8           # Mindest-Erfolgsquote für "Empfehlung"
claude_permission_mode = "bypassPermissions"   # nur in isolierten Arbeitsverzeichnissen!
codex_sandbox = "workspace-write"
